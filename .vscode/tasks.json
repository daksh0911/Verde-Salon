{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verdé: start full app backend",
      "type": "shell",
      "command": "npm run server",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "verde",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Verdé running on http://localhost:5000"
        }
      }
    }
  ]
}
